---
import Layout from "@/layouts/Layout.astro";

// TODO: Check if user is already logged in
// If logged in, redirect to /trips
// This will be implemented when backend auth is ready
---

<Layout title="Tripbook - Twoja biblioteka wycieczek">
  <div
    class="flex min-h-screen items-center justify-center bg-gradient-to-br from-indigo-900 via-purple-900 to-blue-900"
  >
    <div
      class="max-w-md w-full mx-4 space-y-8 p-8 bg-white/10 backdrop-blur-xl rounded-2xl border border-white/10 shadow-2xl"
    >
      <div class="text-center space-y-4">
        <h1 class="text-5xl font-bold text-white mb-2">Tripbook</h1>
        <p class="text-blue-100/90 text-lg">Twoja osobista biblioteka wycieczek</p>
        <p class="text-blue-200/70 text-sm">Planuj, zapisuj i dziel się swoimi przygodami</p>
      </div>

      <div class="space-y-4 pt-4">
        <a
          href="/login"
          class="block w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-center transition-colors duration-200 shadow-lg hover:shadow-xl"
        >
          Zaloguj się
        </a>
        <a
          href="/register"
          class="block w-full py-3 px-4 bg-white/10 hover:bg-white/20 text-white font-medium rounded-lg text-center transition-colors duration-200 border border-white/20 hover:border-white/30"
        >
          Zarejestruj się
        </a>
      </div>

      <div class="pt-4 text-center text-xs text-blue-200/50">Dołącz do społeczności podróżników</div>
    </div>
  </div>
</Layout>
