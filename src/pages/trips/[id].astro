---
import Layout from "../../layouts/Layout.astro";
import TripDetailsContainer from "../../components/trips/TripDetailsContainer";

const { id } = Astro.params;
---

<Layout title="Trip Details - Tripbook">
  <main class="flex h-screen flex-col bg-background">
    <div class="container mx-auto flex h-full flex-col px-4 py-4">
      <TripDetailsContainer id={id} client:load />
    </div>
  </main>
</Layout>
