---
import Layout from "@/layouts/Layout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";

// Token is extracted client-side from URL hash by the React component
// Supabase sends it as: /reset-password#access_token=xxx&type=recovery
---

<Layout title="Resetowanie hasła - Tripbook">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-50 via-white to-purple-50">
    <ResetPasswordForm client:load />
  </div>
</Layout>
