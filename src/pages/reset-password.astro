---
import Layout from "@/layouts/Layout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";

// Get token from query params
const token = Astro.url.searchParams.get("token");

// TODO: Validate token with Supabase when backend is ready
---

<Layout title="Resetowanie hasła - Tripbook">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-50 via-white to-purple-50">
    <ResetPasswordForm client:load token={token} />
  </div>
</Layout>
