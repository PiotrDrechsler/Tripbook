---
import Layout from "@/layouts/Layout.astro";
import LoginForm from "@/components/auth/LoginForm";

// Get message from query params
const message = Astro.url.searchParams.get("message") || undefined;

// Per-page auth check: if user is already logged in, redirect to /trips
// Note: middleware also handles this, but we add it here for extra safety
const session = Astro.locals.session;

if (session) {
  return Astro.redirect("/trips");
}
---

<Layout title="Logowanie - Tripbook">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-50 via-white to-purple-50">
    <LoginForm client:load message={message} />
  </div>
</Layout>
