---
import "../styles/global.css";
import UserMenu from "@/components/auth/UserMenu";

interface Props {
  title?: string;
}

const { title = "10x Astro Starter" } = Astro.props;

// TODO: Get user from session when backend auth is ready
// For now, we'll use a mock user for demonstration
// const session = await locals.supabase.auth.getSession();
// const user = session.data.session?.user;
const user: { email: string } | null = null; // Will be replaced with actual user from session
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {
      user && (
        <header class="fixed top-0 right-0 p-4 z-50">
          <UserMenu client:load userEmail={(user as { email: string }).email} />
        </header>
      )
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  body {
    display: flex;
    flex-direction: column;
  }
</style>
